# Settings for the compose stack, read from this directory (`deploy/.env`).
# Compose interpolates it for the Postgres service and passes it to the app,
# so DB_* here configure both sides. The defaults below match the app's own
# dev defaults — a clean checkout runs without this file at all.

# Postgres (defaults: vishnu / vishnu / vishnu on 127.0.0.1:5432)
DB_USER=vishnu
DB_PASS=vishnu
DB_NAME=vishnu
# Host publish port only; the app always talks to Postgres on 5432.
DB_PORT=5432

# Host publish port for the web front — the browser entry point
# (in-container nginx listens on 80 and proxies /api + /p to the api).
VISHNU_HOST_PORT=8080

# Host .ssh mounted read-only into the api container for GitHub clones
# (default: ~/.ssh of whoever runs docker compose — under sudo that's
# /root/.ssh, so set this to the account that has the deploy key).
# VISHNU_SSH_DIR=/home/deploy/.ssh

# Crush needs provider credentials or agent init fails with a 500.
# The compose files mount the composing user's ~/.config/crush +
# ~/.local/share/crush into the container (crush runs as root there), so
# a `crush` run once on the server — model picked, provider logged in —
# is picked up automatically. Under sudo / a different deploy user, point
# these at that account's dirs:
# VISHNU_CRUSH_CONFIG_DIR=/home/deploy/.config/crush
# VISHNU_CRUSH_DATA_DIR=/home/deploy/.local/share/crush
# API-key alternative (no config mount needed): the CRUSH_ prefix is
# mapped away inside crush, which auto-enables the provider and selects
# its default models:
# CRUSH_ANTHROPIC_API_KEY=
# CRUSH_OPENAI_API_KEY=
# CRUSH_OPENROUTER_API_KEY=

# Where the web front proxies /api + /p + /healthz — the compose-network
# api by default, or any reachable URL (e.g. https://api.example.com)
# when the api lives on another host/domain.
# VISHNU_API_UPSTREAM=http://vishnu:8080
# DNS resolver for upstream names — docker's 127.0.0.11 by default; set
# a public resolver only if the container isn't on a docker network.
# VISHNU_DNS_RESOLVER=127.0.0.1

# Loopback publish for direct api access (debugging); the api container
# always listens on 8080 inside the compose network.
VISHNU_API_PORT=8081

# Image tags for the prod stack (deploy/docker-compose.prod.yml +
# deploy.sh). Defaults are `latest`.
# VISHNU_API_TAG=latest
# VISHNU_WEB_TAG=latest

# production prefixes email subjects; DB_PASS becomes required.
VISHNU_ENV=production

# Email one-time codes (unset → the code is logged instead).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# First admin user, upserted at boot.
VISHNU_BOOTSTRAP_EMAIL=

# Sign-in lifetime (default 720h).
VISHNU_SESSION_TTL=720h
