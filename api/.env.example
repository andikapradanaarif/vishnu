# Vishnu API — host-side environment (make dev, make migrate, ./bin/vishnu-api)
# Loaded via godotenv in internal/config — real env vars always win.

# --- Postgres ---------------------------------------------------------
# Any reachable Postgres works. Native install: DB_PORT=5432. If you use
# the compose stack (`make up`), its container publishes on the DB_PORT
# from deploy/.env (55432 on machines where 5432 is already taken) —
# point this at whichever Postgres should hold the vishnu db.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vishnu
DB_USER=vishnu
DB_PASS=vishnu
DB_SSL_MODE=disable

# --- Server ------------------------------------------------------------
VISHNU_LISTEN_ADDR=127.0.0.1:8080
# development keeps cookies non-Secure so sign-in works over plain http.
VISHNU_ENV=development
# SPA source override — unset uses the embedded build in webui/dist.
VISHNU_WEB_DIR=
VISHNU_SESSION_TTL=720h
# Upserted as an admin user at startup — required to sign in.
VISHNU_BOOTSTRAP_EMAIL=

# --- Crush / projects --------------------------------------------------
# Root data dir (crush configs, sockets); default: $XDG_DATA_HOME/vishnu.
VISHNU_DATA_DIR=
# Clone destination for GitHub-sourced projects (default: $VISHNU_DATA_DIR/projects).
VISHNU_PROJECTS_DIR=
# crush binary override (default: crush on PATH).
VISHNU_CRUSH_BIN=
# First port handed to per-project crush servers.
VISHNU_PORT_START=9201

# --- Brevo (OTP email) --------------------------------------------------
# Transactional email for sign-in codes. When BREVO_API_KEY is unset the
# code is logged to stdout instead — enough for local dev.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
VISHNU_EMAIL_TIMEOUT=10s

# --- Tests --------------------------------------------------------------
# Repository tests need a real Postgres; set this to run them.
# VISHNU_TEST_DB_DSN="host=127.0.0.1 port=55432 user=vishnu password=vishnu dbname=vishnu sslmode=disable"
