{
	"name": "vishnu-web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Vishnu — web UI for crush sessions",
	"scripts": {
		"dev": "vite",
		"dev:mock": "VITE_API_UPSTREAM=http://127.0.0.1:8081 vite",
		"mock": "bun run scripts/mock-api.ts",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b",
		"lint": "tsc -b && oxlint .",
		"lint:fix": "oxlint . --fix",
		"format": "bun fmt --use-tabs --print-width=100 . '!src/routeTree.gen.ts'",
		"format:check": "bun fmt --check --use-tabs --print-width=100 . '!src/routeTree.gen.ts'",
		"preview": "vite preview"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/press-start-2p": "^5.3.0",
		"@fontsource/vt323": "^5.3.0",
		"@iconify/react": "^6.0.2",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.3",
		"@tanstack/react-router": "^1.170.45",
		"@vishnu/api-contract": "workspace:*",
		"@vishnu/ui-component": "workspace:*",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.47",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxlint": "^1.88.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	}
}
