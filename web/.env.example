# Dev-server proxy target for /api and /p — where vite forwards browser
# traffic. Defaults to the local api on http://127.0.0.1:8080, so this
# file is only needed to point the local SPA somewhere else:
#
#   # the deployed server (through its web front domain)
#   VITE_API_UPSTREAM=https://vishnu.example.com
#
#   # a loopback-only server, through an SSH tunnel
#   #   ssh -L 8080:127.0.0.1:8080 server
#   VITE_API_UPSTREAM=http://127.0.0.1:8080
#
# Shell env wins over this file (`VITE_API_UPSTREAM=… bun run dev`);
# `bun run dev:mock` uses it to hit scripts/mock-api.ts on :8081.
# VITE_API_UPSTREAM=
