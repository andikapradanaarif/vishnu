# nginx front for the vishnu SPA. Serves the static build and reverse-proxies
# the API and per-project crush traffic — the browser only ever talks to
# this service, no matter where the api lives.
#
# envsubst'd at container start (official nginx entrypoint, restricted to
# VISHNU_* vars via NGINX_ENVSUBST_FILTER):
#   VISHNU_API_UPSTREAM  where /api, /p, /healthz forward — a compose-
#                        network name (http://vishnu:8080, default) or any
#                        reachable URL when the api sits elsewhere /
#                        another domain (https://api.example.com)
#   VISHNU_DNS_RESOLVER  resolver for upstream names — 127.0.0.11 inside
#                        docker networks; a public resolver otherwise
#
# `proxy_pass $api` goes through the resolver so the upstream is
# re-resolved per request; a recreated api container with a new IP does
# not leave nginx proxying to a stale address.
resolver ${VISHNU_DNS_RESOLVER} valid=10s ipv6=off;

server {
	listen 80;
	server_name _;
	root /usr/share/nginx/html;
	index index.html;

	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_types text/plain text/css application/javascript application/json application/xml text/xml text/javascript image/svg+xml;

	# Container health / external probes — forwarded to the api so the check
	# covers the whole path, not just nginx.
	location = /healthz {
		set $api ${VISHNU_API_UPSTREAM};
		proxy_pass $api;
	}

	# Vishnu API (projects registry, auth, config).
	location /api/ {
		set $api ${VISHNU_API_UPSTREAM};
		proxy_pass $api;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_read_timeout 5m;
	}

	# Per-project crush traffic, including the SSE events stream
	# (/p/{pid}/v1/workspaces/{id}/events). Buffering and gzip must stay off
	# or events arrive in chunks; the read timeout must outlive an idle
	# stream.
	location /p/ {
		set $api ${VISHNU_API_UPSTREAM};
		proxy_pass $api;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Connection "";
		proxy_buffering off;
		proxy_cache off;
		gzip off;
		proxy_read_timeout 1d;
	}

	# Vite emits content-hashed assets under /assets/ — safe to cache forever.
	location /assets/ {
		add_header X-Content-Type-Options "nosniff";
		add_header Cache-Control "public, max-age=31536000, immutable";
	}

	# SPA fallback: real files first, everything else to index.html.
	# no-cache forces revalidation of HTML so a redeploy can't leave a page
	# referencing /assets/ hashes that no longer exist.
	location / {
		add_header X-Content-Type-Options "nosniff";
		add_header Cache-Control "no-cache";
		try_files $uri $uri/ /index.html;
	}
}
